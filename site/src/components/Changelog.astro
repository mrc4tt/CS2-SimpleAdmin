---
// The full changelog page: CHANGELOG.md with a search over every change and a version jump.
import { changelog, inline, isUnreleased, kindClass, latestRelease, versionId } from '../data/changelog';

const { intro, releases } = changelog();
const total = releases.reduce((n, r) => n + r.count, 0);
const series = new Map<string, string[]>();
for (const r of releases) {
	const key = r.version.split('.').slice(0, 2).join('.');
	series.set(key, [...(series.get(key) ?? []), r.version]);
}
---

<div class="sa-cl" data-sa-built={latestRelease}>
	{intro.map((p) => <p set:html={inline(p)} />)}

	<div class="sa-searchbar not-content">
		<label class="sa-search">
			<span class="sr-only">Search the changelog</span>
			<svg aria-hidden="true" viewBox="0 0 24 24" width="16" height="16"><path fill="currentColor" d="M10 2a8 8 0 0 1 6.32 12.9l5.39 5.4-1.41 1.4-5.4-5.39A8 8 0 1 1 10 2m0 2a6 6 0 1 0 0 12 6 6 0 0 0 0-12" /></svg>
			<input type="search" placeholder={`Search ${total} changes`} autocomplete="off" disabled />
		</label>
		<label>
			<span class="sr-only">Jump to version</span>
			<select class="sa-select" disabled>
				<option value="">Jump to version</option>
				{[...series].map(([key, versions]) => (
					<optgroup label={`${key}.x`}>{versions.map((v) => <option value={versionId(v)}>{v}</option>)}</optgroup>
				))}
			</select>
		</label>
		<p class="sa-count" aria-live="polite"></p>
	</div>

	{releases.map((r) => (
		<section class="sa-cl__rel" id={versionId(r.version)} data-rel>
			<header>
				<h2><a href={`#${versionId(r.version)}`}>{r.version}</a></h2>
				{r.date && <span class="sa-cl__date">{r.date}</span>}
				{isUnreleased(r.version) && <span class="sa-unreleased" data-sa-unreleased={r.version}>Not released yet</span>}
			</header>
			{r.sections.map((s) => (
				<div class="sa-cl__sec" data-sec>
					<h3 class={`sa-cl__kind sa-cl__kind--${kindClass(s.kind)}`}>{s.kind}</h3>
					<ul>{s.items.map((i) => <li set:html={inline(i)} />)}</ul>
				</div>
			))}
		</section>
	))}
</div>

<script>
	for (const root of document.querySelectorAll<HTMLElement>('.sa-cl')) {
		const input = root.querySelector<HTMLInputElement>('input[type=search]')!;
		const select = root.querySelector<HTMLSelectElement>('select')!;
		const count = root.querySelector<HTMLElement>('.sa-count')!;
		const rels = [...root.querySelectorAll<HTMLElement>('[data-rel]')];
		input.disabled = select.disabled = false;
		const filter = () => {
			const words = input.value.toLowerCase().split(/\s+/).filter(Boolean);
			let hits = 0, shown = 0;
			for (const rel of rels) {
				const versionHit = words.length === 1 && rel.querySelector('h2')!.textContent!.startsWith(words[0]);
				let anyRel = false;
				for (const sec of rel.querySelectorAll<HTMLElement>('[data-sec]')) {
					const kind = sec.querySelector('h3')!.textContent!.toLowerCase();
					let anySec = false;
					for (const li of sec.querySelectorAll<HTMLElement>('li')) {
						const text = `${kind} ${li.textContent!.toLowerCase()}`;
						const on = !words.length || versionHit || words.every((w) => text.includes(w));
						li.hidden = !on;
						if (on) { anySec = true; hits++; }
					}
					sec.hidden = !anySec;
					anyRel ||= anySec;
				}
				rel.hidden = !anyRel;
				if (anyRel) shown++;
			}
			count.textContent = words.length ? (hits ? `${hits} changes in ${shown} releases` : 'No changes match.') : '';
		};
		input.addEventListener('input', filter);
		select.addEventListener('change', () => {
			if (!select.value) return;
			if (input.value) { input.value = ''; filter(); }
			location.hash = select.value;
			select.value = '';
		});
	}
</script>

<script>
	import { checkRelease } from '../scripts/release-check.js';
	checkRelease();
</script>

<style>
	.sa-cl__rel { scroll-margin-top: calc(var(--sl-nav-height) + 6rem); }
	.sa-cl__rel header {
		display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.25rem 0.9rem; margin-top: 2.5rem;
		padding-bottom: 0.4rem; border-bottom: 1px solid var(--sa-line);
	}
	.sa-cl__rel h2 { margin: 0; font-variant-numeric: tabular-nums; }
	.sa-cl__rel h2 a { color: inherit; text-decoration: none; }
	.sa-cl__rel h2 a:hover { color: var(--sl-color-accent-high); }
	.sa-cl__date { color: var(--sl-color-gray-3); font-size: var(--sl-text-sm); }
	.sa-cl__kind { margin-top: 1rem; font-size: var(--sl-text-sm); text-transform: uppercase; letter-spacing: 0.06em; color: var(--k); }
	.sa-cl__kind--added { --k: var(--sa-k-added); }
	.sa-cl__kind--changed, .sa-cl__kind--other { --k: var(--sa-k-changed); }
	.sa-cl__kind--fixed { --k: var(--sa-k-fixed); }
	.sa-cl__kind--security { --k: var(--sa-k-security); }
	.sa-cl__kind--removed, .sa-cl__kind--deprecated { --k: var(--sa-k-removed); }
	.sa-cl__sec ul { margin-top: 0.4rem; }
	.sa-cl__rel li + li { margin-top: 0.5rem; }
	.sa-unreleased {
		padding: 0.1rem 0.6rem; border-radius: 999px; font-size: var(--sl-text-xs); font-weight: 600;
		color: var(--sl-color-accent-high); background: var(--sl-color-accent-low);
		border: 1px dashed color-mix(in srgb, var(--sl-color-accent) 55%, transparent);
	}
</style>
