<?xml version="1.0" encoding="utf-8"?>
<!--
  CS2MenuManager comes from the local "packages" folder in this repo instead of nuget.org:
  nuget.org only has the net8.0 build, packages/ holds the net10.0 build from
  github.com/mrc4tt/CS2MenuManager. It is compile-time only; the server loads the runtime
  copy bundled in the release zip. No credentials are needed.

  To bump it, drop the new .nupkg into packages/, remove the old one, and update the
  CS2MenuManager PackageReference version in CS2-SimpleAdmin.csproj.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="local" value="packages" />
  </packageSources>
  <!-- Vulnerability audit: only query nuget.org; a local folder source has no audit endpoint. -->
  <auditSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </auditSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="local">
      <package pattern="CS2MenuManager" />
    </packageSource>
  </packageSourceMapping>
</configuration>
